# Copiază în .env (Windows: copy .env.example .env) și completează. NU pune .env în git.

# --- Cote (obligatoriu) ---------------------------------------------------
# Cheie gratuită de la https://the-odds-api.com (planul gratuit are o limită
# lunară de credite; verifică limitele curente pe site).
ODDS_API_KEY=

# Ligi (chei de sport, separate prin virgulă). Lista completă:
#   docker compose run --rm agent python -m oddsagent sports
# Fiecare ligă consumă ~1 credit la fiecare reîmprospătare (cache-ul reduce asta).
ODDS_SPORTS=soccer_epl,soccer_spain_la_liga,soccer_italy_serie_a,soccer_germany_bundesliga,soccer_france_ligue_one,soccer_uefa_champs_league,soccer_uefa_europa_league

# Regiunea caselor de pariuri (eu, uk, us, au). 'eu' acoperă majoritatea caselor europene.
ODDS_REGIONS=eu

# Opțional: biletele se construiesc doar la aceste case (chei, separate prin virgulă).
# Gol = toate casele returnate. Cheile apar în răspuns, în câmpul "book".
ODDS_BOOKMAKERS=

# Cât timp păstrăm cotele în cache (secunde). Mai mare = mai puține credite folosite.
CACHE_TTL_SECONDS=3600

# Minim de case care trebuie să aibă cote pentru un meci (ca să avem un consens fiabil).
MIN_BOOKS=3

# --- Model LLM (opțional, doar pentru explicații) ---------------------------
# none   = fără LLM, cost zero (implicit)
# ollama = model local în Docker, gratuit (vezi README: profilul local-llm)
# openai = orice API compatibil OpenAI (gratuit cu cotă sau plătit)
LLM_BACKEND=none

# ollama
OLLAMA_MODEL=llama3.2:3b

# openai-compatibil (exemplu OpenAI; schimbă base URL + model pentru alt furnizor)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
